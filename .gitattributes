* text=auto

*.md text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.tsv text eol=lf
*.csv text eol=lf

# Treat unexpected archive and office formats as binary if intentionally added later.
*.zip binary
*.7z binary
*.tar binary
*.gz binary
*.pdf binary
*.docx binary
*.xlsx binary
*.pptx binary
